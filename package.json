{
  "name": "testaipack",
  "version": "0.5.1",
  "description": "A/B tester for opencode integrations — compares work before/after installing a pack (skill/plugin/agent/command/mcp)",
  "type": "module",
  "bin": {
    "testaipack": "./bin/testaipack.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build --compile --outfile=dist/testaipack bin/testaipack.ts",
    "build:all": "bash scripts/release.sh",
    "release": "bash scripts/release.sh && bash scripts/publish-release.sh",
    "dev": "tsx watch bin/testaipack.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contract:compile": "tsp compile ./contract",
    "contract:codegen": "tsp compile ./contract && tsx scripts/codegen.ts && prettier --write src/generated",
    "prepare:dev": "npm run contract:codegen"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "effect": "^3.22.0",
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "@effect/schema": "^0.75.5",
    "zod": "^4.4.3",
    "clipanion": "^4.0.0-rc.4",
    "tar": "^7.5.20",
    "diff2html": "^3.4.56",
    "handlebars": "^4.7.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "tsx": "^4.23.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.65.0",
    "eslint-plugin-functional": "^10.0.0",
    "prettier": "^3.9.6",
    "@typespec/compiler": "^1.14.0",
    "@typespec/openapi3": "^1.14.0",
    "@typespec/json-schema": "^1.14.0",
    "@microsoft/api-extractor": "^7.58.12",
    "bun": "^1.3.14"
  }
}

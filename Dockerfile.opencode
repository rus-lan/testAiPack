# Docker image for testaipack --isolation=docker mode.
# Pre-installs the opencode CLI so `docker run --rm <image> opencode ...` works
# without a published upstream image (opencode/opencode:* does not exist on Docker Hub).
#
# Build:
#   bash scripts/build-docker-image.sh
#   # or: docker build -t testaipack-opencode:latest -f Dockerfile.opencode .
FROM node:22-slim

# System deps: git (clone/diff), ca-certificates (HTTPS), curl (download).
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned opencode version — bump deliberately, not by rebuilding against
# whatever upstream latest happens to be that day. `releases/latest` used to
# be resolved at build time; that let the image silently drift ahead of the
# schema this project validates exports against (contract/main.tsp), which is
# exactly what broke `--isolation docker` runs when a `finish: "unknown"`
# value from a newer opencode hit an older schema (see CHANGELOG). Override
# for a one-off test build without editing this file:
#   docker build --build-arg OPENCODE_VERSION=1.18.9 -f Dockerfile.opencode .
ARG OPENCODE_VERSION=1.18.4

# Install opencode by fetching the pinned release binary directly from GitHub
# (not the official `curl https://opencode.ai/install | bash`, which calls the
# GitHub REST API to resolve a version and is rate-limited (HTTP 403) inside
# CI / Docker builds — a tagged `releases/download/vX.Y.Z` URL redirects to
# the asset without hitting the API).
# Asset name matches the official installer: opencode-<os>-<arch>.tar.gz (linux).
RUN ARCH=x64 \
    && curl -fsSL -o /tmp/opencode.tar.gz \
        "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-${ARCH}.tar.gz" \
    && tar -xzf /tmp/opencode.tar.gz -C /tmp \
    && install -m 0755 /tmp/opencode /usr/local/bin/opencode \
    && rm -f /tmp/opencode /tmp/opencode.tar.gz \
    && opencode --version

# Non-root runtime user (matches the /home/opencode mount target used by docker-runner).
RUN useradd --create-home --shell /bin/bash opencode
USER opencode
WORKDIR /workspace

# Default command; testaipack overrides via `docker run ... <command>`.
CMD ["opencode", "--version"]
